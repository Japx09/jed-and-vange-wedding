{
  "version": 2,
  "rewrites": [
    {
      "source": "/_next/static/:path*",
      "destination": "https://www.cordially.io/_next/static/:path*"
    },
    {
      "source": "/api/rsvp",
      "destination": "/api/index.js?action=rsvp"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
