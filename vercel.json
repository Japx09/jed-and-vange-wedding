{
  "version": 2,
  "headers": [
    {
      "source": "/dress-code/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|svg|ico|mp3)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/_next/static/:path*",
      "destination": "https://www.cordially.io/_next/static/:path*"
    },
    {
      "source": "/api/rsvp",
      "destination": "/api/index.js?action=rsvp"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
